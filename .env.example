# ARE System - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================
# GEMINI API (Required for LLM-powered reasoning)
# ============================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# ACADEMIC SEARCH APIS (Optional - for real paper search)
# ============================================================
SEMANTIC_SCHOLAR_API_KEY=
ARXIV_API_KEY=
OPENALEX_API_KEY=

# ============================================================
# HUGGINGFACE (Optional - for model loading)
# ============================================================
HF_TOKEN=

# ============================================================
# EXECUTION SETTINGS
# ============================================================
# Set to "true" to enable Gemini API calls
USE_GEMINI=false

# Set to "false" to use real APIs instead of mocks
USE_MOCK=true

# Set to "false" to disable real HITL interrupts
ENABLE_REAL_HITL=true
